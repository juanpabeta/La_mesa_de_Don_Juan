APP_NAME=Gestión de Pedidos para Restaurantes
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/restaurantes
SECRET_KEY=cambiar-por-una-clave-aleatoria-segura-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_NAME=access_token
COOKIE_SECURE=false
# En producción usa COOKIE_SECURE=true y un origen HTTPS en CORS_ORIGINS.
COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ENABLE_DELAY_MONITOR=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
PORT=8000

# Solo para docker compose local; en producción usa un gestor de secretos.
POSTGRES_DB=restaurantes
POSTGRES_USER=restaurantes_app
POSTGRES_PASSWORD=cambiar-por-una-contraseña-larga
